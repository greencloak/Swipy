<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon foreground layer.
  Canvas is 108x108dp; only the center 66x66dp ("safe zone") is guaranteed
  visible once the launcher applies its circle/squircle/rounded-square mask.
  The original 24x24 tabler "viewport-tall" icon is scaled 2.75x
  (66 / 24 = 2.75) and translated by 21dp on each axis to center it
  inside that safe zone: (108 - 66) / 2 = 21.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:translateX="21"
        android:translateY="21"
        android:scaleX="2.75"
        android:scaleY="2.75">

        <path
            android:pathData="M12 10v-7l3 3"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <path
            android:pathData="M9 6l3 -3"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <path
            android:pathData="M12 14v7l3 -3"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <path
            android:pathData="M9 18l3 3"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <path
            android:pathData="M18 3h1a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-1"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <path
            android:pathData="M6 3h-1a2 2 0 0 0 -2 2v14a2 2 0 0 0 2 2h1"
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

    </group>
</vector>
